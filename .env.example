# Written by scripts/install.sh (install) or by hand (dev).
# NODOCK_SECRET is the single source of truth for the encryption key.
# Losing it makes every encrypted variable unrecoverable. Back it up.
NODOCK_SECRET=            # openssl rand -hex 32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_LOGIN=       # comma-separated GitHub usernames (not emails). Blank = nobody can sign in.
NODOCK_URL=https://panel.example.com
BASE_DOMAIN=apps.example.com
ACME_EMAIL=you@example.com

# Optional: private GHCR packages need a classic PAT with read:packages.
# Docker login to ghcr.io does not accept GitHub OAuth tokens.
GHCR_USER=
GHCR_TOKEN=

# Optional overrides
# DATA_DIR=./.data        # host default; the Docker image sets /data
# PORT=3000
# DOCKER_NETWORK=nodock
# NODOCK_ACCESS_LOG=1
# Extra origins allowed to send mutating requests; needed only for the Vite dev
# server on :5173, since NODOCK_URL stays http://localhost:3000 for the callback.
# ALLOWED_ORIGINS=http://localhost:5173
