# Written by scripts/install.sh (install) or filled in by hand (dev).
#
# No inline comments in this file: Docker's env_file parser keeps `value # note`
# as the value, which would break ADMIN_GITHUB_LOGIN. Comments go on their own line.

# Single source of truth for the encryption key (openssl rand -hex 32).
# Losing it makes every encrypted variable unrecoverable. Back it up.
NODOCK_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your GitHub username (not your email). Comma-separated for several.
# Blank means nobody can sign in.
ADMIN_GITHUB_LOGIN=

NODOCK_URL=https://panel.example.com
BASE_DOMAIN=apps.example.com

# Let's Encrypt expiry notices only; must be a real inbox.
ACME_EMAIL=you@example.com

# Optional: private GHCR packages need a classic PAT with read:packages.
# Docker login to ghcr.io does not accept GitHub OAuth tokens.
GHCR_USER=
GHCR_TOKEN=

# Optional overrides
# DATA_DIR=./.data
# PORT=3000
# DOCKER_NETWORK=nodock
# NODOCK_ACCESS_LOG=1
# Extra origins allowed to send mutating requests; needed only for the Vite dev
# server on :5173, since NODOCK_URL stays the callback origin.
# ALLOWED_ORIGINS=http://localhost:5173
