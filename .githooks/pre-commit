#!/usr/bin/env bash
# Fast pre-commit: secret scan + format + lint only the files in this commit.
# Bypass with `git commit --no-verify` (CI still runs the full `bun run verify`).
set -e

# First, before anything is rewritten in the working tree on the way to a commit
# that would never happen. Skips itself when gitleaks is not installed.
sh scripts/check-secrets.sh --staged

files=()
while IFS= read -r -d '' file; do
  case "$file" in
    # Only files the formatter and linter actually own.
    *.ts | *.tsx | *.js | *.jsx | *.json | *.css | *.md) files+=("$file") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ ${#files[@]} -eq 0 ]; then
  exit 0
fi

bunx oxfmt --write "${files[@]}"
# Re-stage whatever the formatter rewrote (oxfmt skips unchanged files).
git add -- "${files[@]}"

code=()
for file in "${files[@]}"; do
  case "$file" in
    *.ts | *.tsx | *.js | *.jsx) code+=("$file") ;;
  esac
done

if [ ${#code[@]} -eq 0 ]; then
  exit 0
fi

bunx oxlint "${code[@]}"
