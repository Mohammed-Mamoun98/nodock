{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "import", "oxc"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off",
    "restriction": "off"
  },
  "rules": {
    "no-console": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "unicorn/prefer-node-protocol": "error",
    "eqeqeq": ["error", "smart"]
  },
  "overrides": [
    {
      "files": ["scripts/**", "**/*.test.ts"],
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/.superdesign/**",
    "apps/server/drizzle/**",
    "node_modules/**"
  ]
}
